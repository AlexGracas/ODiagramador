<Project Sdk="Microsoft.NET.Sdk">
  <!-- ODiagramador for Windows: WPF + WebView2 over the shared Rust core (odg_ffi.dll). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OdgTargetFramework Condition="'$(OdgTargetFramework)' == ''">net10.0-windows</OdgTargetFramework>
    <TargetFramework>$(OdgTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ODiagramador</AssemblyName>
    <RootNamespace>ODiagramador</RootNamespace>
    <Version>0.4.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <ApplicationIcon>$(RepoRoot)assets\app-icon\odiagramador.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <!-- shared render-kit (same files every platform loads) -->
  <ItemGroup>
    <Content Include="$(RepoRoot)render-kit\index.html;$(RepoRoot)render-kit\bridge.js;$(RepoRoot)render-kit\palette.js;$(RepoRoot)render-kit\viewer.css">
      <Link>render-kit\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(RepoRoot)render-kit\vendor\*">
      <Link>render-kit\vendor\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- brand marks for the MCP menu (Simple Icons, CC0) -->
  <ItemGroup>
    <Content Include="$(RepoRoot)assets\icons\*">
      <Link>icons\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)LICENSE">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Rust core + CLI/MCP server: cargo build, release profile, packages odg-ffi and odg-cli -->
  <ItemGroup>
    <None Include="$(RepoRoot)target\release\odg_ffi.dll" Condition="Exists('$(RepoRoot)target\release\odg_ffi.dll')">
      <Link>odg_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(RepoRoot)target\release\odg.exe" Condition="Exists('$(RepoRoot)target\release\odg.exe')">
      <Link>odg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
