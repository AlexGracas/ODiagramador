<Application x:Class="ODiagramador.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ErrorBrush" Color="#D1242F" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
        <SolidColorBrush x:Key="InfoBrush" Color="#0969DA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#59636E" />
    </Application.Resources>
</Application>
