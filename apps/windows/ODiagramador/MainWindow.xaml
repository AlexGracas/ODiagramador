<Window x:Class="ODiagramador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="ODiagramador" Width="1280" Height="820" MinWidth="900" MinHeight="560">
    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- toolbar icon button with its own template: clear hover / pressed / focus states in light and dark -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#24808080" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#30808080" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#40808080" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <DockPanel>
        <!-- toolbar: icon buttons (Segoe Fluent / MDL2 glyphs, brand marks for MCP) -->
        <Border DockPanel.Dock="Top" Padding="6,4" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Click="OnOpenFolder">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xED25;" />
                    </Button>
                    <Button x:Name="NewButton" Style="{StaticResource IconButton}" Click="OnNewDiagram">
                        <Grid>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-3" />
                        </Grid>
                    </Button>
                    <Button x:Name="ExportButton" Style="{StaticResource IconButton}" Click="OnOpenMenu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEDE1;" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="PNG" Click="OnExportPng">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xEB9F;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="SVG" Click="OnExportSvg">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE943;" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="McpButton" Style="{StaticResource IconButton}" Click="OnOpenMenu">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl x:Name="McpIcon" Width="16" Height="16" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="McpMenu" />
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="UpdateButton" Style="{StaticResource IconButton}" Click="OnShowUpdate" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="OnSettings">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </DockPanel>
        </Border>

        <!-- status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <DockPanel Grid.Column="0" x:Name="SidebarPane">
                <DockPanel DockPanel.Dock="Top" Margin="8,6,4,2">
                    <!-- hide the list: it leaves a "DIAGRAMS" strip that brings it back -->
                    <Button x:Name="CollapseListButton" DockPanel.Dock="Right" Click="OnCollapseListClick" Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="4,0">
                        <TextBlock Text="&#xE76B;&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                    </Button>
                    <TextBlock x:Name="DiagramsHeader" Foreground="{StaticResource MutedBrush}" />
                </DockPanel>
                <!-- how the list is organised -->
                <Grid DockPanel.Dock="Top" Margin="6,0,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="GroupBox" Grid.Column="0" FontSize="11" SelectionChanged="OnListOptionsChanged">
                        <ComboBoxItem Tag="project" />
                        <ComboBoxItem Tag="none" />
                        <ComboBoxItem Tag="kind" />
                        <ComboBoxItem Tag="folder" />
                    </ComboBox>
                    <ComboBox x:Name="SortBox" Grid.Column="2" FontSize="11" SelectionChanged="OnListOptionsChanged">
                        <ComboBoxItem Tag="name" />
                        <ComboBoxItem Tag="date" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                <ListBox x:Name="DiagramList" BorderThickness="0" SelectionChanged="OnDiagramSelected">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True">
                                                    <Expander.Header>
                                                        <DockPanel Margin="4,2,6,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2" ToolTip="{Binding TooltipText}">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="20" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Badge}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ShortDate}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <Border Visibility="{Binding KindVisibility}" Background="{Binding KindBackground}" CornerRadius="7" Padding="5,0" Margin="0,0,5,0">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding KindColor}" />
                                        </Border>
                                        <TextBlock Text="{Binding FolderText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <!-- strip left by the collapsed diagram list: its name, click to bring it back -->
            <Button x:Name="ListRail" Grid.Column="0" Visibility="Collapsed" Click="OnListRailClick" Cursor="Hand"
                    BorderThickness="0,0,1,0" Padding="0,10,0,0" VerticalContentAlignment="Top" HorizontalContentAlignment="Center"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <StackPanel>
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="ListRailText" Margin="0,8,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}">
                        <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Button>
            <!-- drag to resize, double-click to collapse / restore the diagram list -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" MouseDoubleClick="OnSidebarSplitterDoubleClick" />

            <Grid Grid.Column="2" x:Name="RightGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" x:Name="EditorGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" x:Name="CodePane">
                        <TextBlock x:Name="AgentBadge" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="6,2"
                                   Foreground="#8250DF" Visibility="Collapsed" />
                        <ae:TextEditor x:Name="Editor" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                       ShowLineNumbers="True" WordWrap="False" TextChanged="OnSourceChanged" />
                    </DockPanel>
                    <!-- strip left by the collapsed code: its name, click to bring it back -->
                    <Button x:Name="CodeRail" Grid.Column="0" Visibility="Collapsed" Click="OnCodeRailClick" Cursor="Hand"
                            BorderThickness="0,0,1,0" Padding="0,10,0,0" VerticalContentAlignment="Top" HorizontalContentAlignment="Center"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                        <StackPanel>
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="CodeRailText" Margin="0,8,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}">
                                <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- drag to resize, double-click to collapse / restore the code -->
                    <GridSplitter x:Name="CodeSplitter" Grid.Column="1" Width="9" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                                  MouseDoubleClick="OnCodeSplitterDoubleClick">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Rectangle Width="1" Fill="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                                    <Border Width="9" Height="28" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                        <TextBlock x:Name="CodeChevron" Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <wv2:WebView2 x:Name="Viewer" Grid.Column="2" />
                </Grid>
                <!-- drag to resize, double-click to collapse / restore the bottom panel -->
                <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Height="9" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              MouseDoubleClick="OnBottomSplitterDoubleClick">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Rectangle Height="1" Fill="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                                <Border Width="28" Height="9" CornerRadius="3" BorderThickness="1" HorizontalAlignment="Center"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <!-- strip left by the collapsed bottom panel: its name, click to bring it back -->
                <Button x:Name="BottomRail" Grid.Row="2" Visibility="Collapsed" Click="OnBottomRailClick" Cursor="Hand"
                        BorderThickness="0,1,0,0" Padding="10,0,0,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="BottomRailText" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Button>
                <TabControl Grid.Row="2" x:Name="Tabs">
                    <TabItem x:Name="ProblemsTab">
                        <DockPanel>
                            <!-- what this tab is for -->
                            <TextBlock x:Name="ProblemsHelp" DockPanel.Dock="Top" Margin="6,4" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        <ListBox x:Name="ProblemList" BorderThickness="0" SelectionChanged="OnProblemSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="22" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Location}" Foreground="{StaticResource MutedBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="FeedbackTab">
                        <DockPanel>
                            <!-- what this tab is for -->
                            <TextBlock x:Name="FeedbackHelp" DockPanel.Dock="Top" Margin="6,4" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="4">
                                <DockPanel>
                                    <Button x:Name="AddFeedbackButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2" Click="OnAddFeedback" />
                                    <TextBlock x:Name="ElementTag" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                               FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="FeedbackBox" KeyDown="OnFeedbackKey" />
                                </DockPanel>
                                <!-- context sent with the comment: diagram, selected element, its lines (editable) -->
                                <Expander x:Name="ContextExpander" IsExpanded="True" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBox x:Name="ContextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72" Margin="0,4,0,0"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                 TextChanged="OnContextEdited" />
                                        <DockPanel Margin="0,4,0,0">
                                            <CheckBox x:Name="IncludeContextBox" DockPanel.Dock="Left" IsChecked="True" VerticalAlignment="Center" Click="OnIncludeContext" />
                                            <Button x:Name="RegenerateContextButton" DockPanel.Dock="Left" Margin="8,0,0,0" Padding="8,1" Click="OnRegenerateContext" />
                                            <TextBlock x:Name="ContextHint" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <ListBox x:Name="FeedbackList" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="22" />
                                            <Button DockPanel.Dock="Right" Tag="{Binding Id}" Click="OnResolveFeedback"
                                                    Content="✔" Padding="6,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding Context}" FontSize="10" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                                                           MaxHeight="56" Opacity="0.6" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="ActivityTab">
                        <DockPanel>
                            <!-- what this tab is for -->
                            <TextBlock x:Name="ActivityHelp" DockPanel.Dock="Top" Margin="6,4" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        <ListBox x:Name="ActivityList" BorderThickness="0" FontFamily="Consolas">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="22" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Line}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
            Padding="14,8" CornerRadius="16" Background="#E6202020">
        <TextBlock x:Name="ToastText" Foreground="White" />
    </Border>
    </Grid>
</Window>
